# update.env 模板：复制为 update.env（已 gitignore）并填入你的密钥
# 供 update.sh（服务器 cron / 本机定时，即方案 B/C）使用。
# 方案 A（GitHub Actions 全自动）不用本文件：除仓库 Secret GLM_API_KEY 外，
# 还需细粒度 PAT + scf-trigger/ 云函数定时触发，见 README「自动更新 → 方案 A」。

# 智谱 GLM（Anthropic 兼容端点）
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=你的智谱APIKey
CHANGELOG_TRANSLATOR_MODEL=glm-5.3

# 也可换成任何 Anthropic Messages API 兼容网关（官方 API、中转站、内部网关等）
